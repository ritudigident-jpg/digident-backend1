# Copy to .env and fill in. The server checks these at startup (src/config/env.config.js).
# Required values are marked (required); the server stops with a clear message if one is missing.

NODE_ENV=development
PORT=3000
# debug | info | warn | error | silent (default: info in production, debug otherwise)
LOG_LEVEL=

# Database and cache (required)
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT secrets (required)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Frontends
FRONTEND_URL=
CLIENT_URL=
# Extra allowed browser origins, comma separated (permanent ones are in src/config/cors.config.js)
CORS_ORIGINS=

APP_NAME=
ADMIN_EMAIL=

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Encrypts employee bank account / PAN / Aadhaar / UAN (32 random bytes, base64). Required before
# saving bank details. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes stored values unreadable.
FIELD_ENCRYPTION_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google / Microsoft login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=

# Zoho Mail
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_EMAIL=
ZOHO_WEBHOOK_SECRET=
